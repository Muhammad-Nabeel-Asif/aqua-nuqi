{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    // No `baseUrl`: it is deprecated in TS 6 and removed in 7. Since TS 4.1
    // `paths` resolve relative to this file, so `./` prefixes are all that is
    // needed. Nothing imports bare `src/...`, only the aliases below.
    "paths": {
      "@main/*": ["./src/main/*"],
      "@shared/*": ["./src/shared/*"]
    },
    "outDir": "./out"
  },
  "include": [
    "electron.vite.config.ts",
    "drizzle.config.ts",
    "vitest.config.ts",
    "scripts/**/*.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/main/**/*.test.ts",
    "src/shared/**/*.test.ts"
  ]
}
