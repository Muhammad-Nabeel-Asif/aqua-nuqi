{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    // Pinned rather than relying on the default walk-up from this file's
    // directory: the editor and the CLI resolve `types` independently, and a
    // stale language-service cache reports "Cannot find type definition file
    // for 'node'" while `tsc` stays green. An explicit root removes the
    // ambiguity.
    "typeRoots": ["./node_modules/@types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    // No `baseUrl`: it is deprecated in TS 6 and removed in 7. Since TS 4.1
    // `paths` resolve relative to this file, so `./` prefixes are all that is
    // needed. Nothing imports bare `src/...`, only the aliases below.
    "paths": {
      "@main/*": ["./src/main/*"],
      "@shared/*": ["./src/shared/*"]
    },
    // electron-vite builds main/preload; tsc only typechecks. Emitting here is
    // not merely redundant — `outDir: ./out` made `tsc -b` write out/src/**,
    // out/scripts/** and out/*.js into Vite's output directory, which
    // electron-builder packages wholesale via `files: out/**/*`.
    "noEmit": true
  },
  "include": [
    "electron.vite.config.ts",
    "drizzle.config.ts",
    "vitest.config.ts",
    "vitest.renderer.config.ts",
    "scripts/**/*.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/main/**/*.test.ts",
    "src/shared/**/*.test.ts"
  ]
}
